{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shelfcontrol",
  "main": "worker/index.ts",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": [ "nodejs_compat" ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
